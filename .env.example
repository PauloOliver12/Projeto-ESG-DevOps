# Copie para ".env" e ajuste os valores: cp .env.example .env
# Em staging/producao este arquivo e gerado pelo pipeline a partir dos GitHub Secrets.

# Nome do projeto Compose (isola containers, rede e volume de cada ambiente)
COMPOSE_PROJECT_NAME=esg-local

# Ambiente / perfil Spring: local | staging | production
APP_ENV=local
APP_VERSION=local

# Imagem da API (no servidor: ghcr.io/<usuario>/esg-compliance-api:<tag>)
APP_IMAGE=esg-compliance-api:local

# Portas publicadas no host
APP_PORT=8080
DB_PORT=1521

# Banco Oracle
ORACLE_PASSWORD=Oracle123
DB_USERNAME=projetof
DB_PASSWORD=projetof123

# Usuarios da API (HTTP Basic)
ADMIN_PASSWORD=Admin@123
AUDITOR_PASSWORD=Auditor@123
ANALYST_PASSWORD=Analyst@123

# Opcoes da JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
